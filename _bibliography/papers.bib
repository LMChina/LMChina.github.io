  journal = {Special Structures},
  journal_zh = {特种结构},
  volume  = {38},
  number  = {03},
  pages   = {42--48},
  year    = {2021},
  doi     = {10.19786/j.tzjg.2021.03.009},
  google_scholar_id = {ZeXyd9-uunAC},
  language = {zh},
  abstract_zh = {随着地下综合管廊的大量建设和深入研究，带有预应力的预制拼装地下综合管廊发展迅速。在多舱组合预制拼装综合管廊体系中，施加横向预应力对结构的影响尚需深入研究，为了探究不同预应力大小和不同组合形式对综合管廊的受力性能的影响，以保定某综合管廊和上海某综合管廊为例，采用非线性有限元计算的方法，对常见的两种四舱结构（4×1和2×2）在不同组合形式和不同预应力值大小下的变形及受力进行了有限元分析。有限元分析结果表明：对于横向拼装结构，增加预应力可以有效地增加结构整体性，使横向拼装结构的变形和应力接近整体结构，甚至优于整体结构；对于纵向拼装结构，无预应力纵向拼装结构在变形和应力上与整体结构类似，增加预应力对结构的受力和变形影响不大。分析结果可为今后多舱组合预制拼装预应力综合管廊结构的研究及应用提供参考。},
  bibtex_show = {true},
  pdf         = {wang2021finite_element_fabricated_tunnel.pdf},
  preview     = {wang2021finite_element_fabricated_tunnel.png}
}

